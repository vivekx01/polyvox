# --- App / security ---
ENV=production
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
SESSION_COOKIE_NAME=polyvox_session
SESSION_MAX_AGE_SECONDS=604800

# --- Admin bootstrap (used once on first startup if no admin exists yet) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# --- Database ---
# Points at Coolify's shared-postgres resource (own network, not this compose
# file). Create a dedicated database first: CREATE DATABASE polyvox;
DATABASE_URL=postgresql+psycopg://postgres:changeme@shared-postgres:5432/polyvox

# --- Redis / RQ ---
# Points at Coolify's shared-redis resource. DB index 2 (not 0) to avoid
# colliding with other hosted apps that may also use this shared instance.
REDIS_URL=redis://default:changeme@shared-redis:6379/2
RQ_QUEUE_NAME=tts
RQ_JOB_TIMEOUT_SECONDS=600
RQ_RESULT_TTL_SECONDS=86400
RQ_FAILURE_TTL_SECONDS=86400

# --- TTS engine ---
SUPERTONIC_MODEL=supertonic-3
SUPERTONIC_DEFAULT_VOICE=M1
SUPERTONIC_DEFAULT_LANG=en
SUPERTONIC_DEFAULT_STEPS=8
ONNX_THREADS=4
MAX_TEXT_CHARS=20000
CHUNK_SILENCE_SECONDS=0.3

# --- Audio storage / cleanup ---
AUDIO_STORAGE_DIR=/data/audio
AUDIO_TTL_SECONDS=1800
AUDIO_STORAGE_MAX_BYTES=5368709120
AUDIO_CLEANUP_INTERVAL_SECONDS=60

# --- Web server ---
HOST=0.0.0.0
PORT=8000
UVICORN_WORKERS=1
